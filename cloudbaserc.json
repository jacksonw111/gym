{
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "version": "2.0",
  "envId": "{{env.CLOUDBASE_ENV_ID}}",
  "functionRoot": "cloudfunctions",
  "framework": {
    "plugins": {
      "admin": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "buildCommand": "npm run admin:build",
          "outputPath": "admin/dist",
          "cloudPath": "/admin"
        }
      },
      "database": {
        "use": "@cloudbase/framework-plugin-database",
        "inputs": {
          "collections": [
            {
              "collectionName": "users",
              "createIndexes": [
                {
                  "name": "openid_unique",
                  "keys": [
                    {
                      "name": "openId",
                      "direction": 1
                    }
                  ],
                  "unique": true,
                  "sparse": true
                }
              ]
            },
            {
              "collectionName": "coaches",
              "createIndexes": [
                {
                  "name": "coach_user_unique",
                  "keys": [
                    {
                      "name": "userId",
                      "direction": 1
                    }
                  ],
                  "unique": true,
                  "sparse": true
                },
                {
                  "name": "coach_status",
                  "keys": [
                    {
                      "name": "status",
                      "direction": 1
                    }
                  ]
                }
              ]
            },
            {
              "collectionName": "products",
              "createIndexes": [
                {
                  "name": "product_status",
                  "keys": [
                    {
                      "name": "status",
                      "direction": 1
                    }
                  ]
                },
                {
                  "name": "product_coach",
                  "keys": [
                    {
                      "name": "coachId",
                      "direction": 1
                    }
                  ]
                }
              ]
            },
            {
              "collectionName": "memberships",
              "createIndexes": [
                {
                  "name": "membership_member",
                  "keys": [
                    {
                      "name": "memberId",
                      "direction": 1
                    }
                  ]
                },
                {
                  "name": "membership_coach",
                  "keys": [
                    {
                      "name": "coachId",
                      "direction": 1
                    }
                  ]
                }
              ]
            },
            {
              "collectionName": "orders",
              "createIndexes": [
                {
                  "name": "payment_id_unique",
                  "keys": [
                    {
                      "name": "paymentId",
                      "direction": 1
                    }
                  ],
                  "unique": true
                },
                {
                  "name": "order_member_request_unique",
                  "keys": [
                    {
                      "name": "memberId",
                      "direction": 1
                    },
                    {
                      "name": "requestId",
                      "direction": 1
                    }
                  ],
                  "unique": true
                },
                {
                  "name": "order_status",
                  "keys": [
                    {
                      "name": "status",
                      "direction": 1
                    }
                  ]
                }
              ]
            },
            {
              "collectionName": "schedules",
              "createIndexes": [
                {
                  "name": "coach_schedule_unique",
                  "keys": [
                    {
                      "name": "coachId",
                      "direction": 1
                    },
                    {
                      "name": "startsAt",
                      "direction": 1
                    }
                  ],
                  "unique": true
                }
              ]
            },
            {
              "collectionName": "lessons",
              "createIndexes": [
                {
                  "name": "coach_starts_unique",
                  "keys": [
                    {
                      "name": "coachId",
                      "direction": 1
                    },
                    {
                      "name": "startsAt",
                      "direction": 1
                    }
                  ],
                  "unique": true
                },
                {
                  "name": "member_status",
                  "keys": [
                    {
                      "name": "memberId",
                      "direction": 1
                    },
                    {
                      "name": "status",
                      "direction": 1
                    }
                  ]
                },
                {
                  "name": "member_request_unique",
                  "keys": [
                    {
                      "name": "memberId",
                      "direction": 1
                    },
                    {
                      "name": "requestId",
                      "direction": 1
                    }
                  ],
                  "unique": true
                },
                {
                  "name": "lesson_status",
                  "keys": [
                    {
                      "name": "status",
                      "direction": 1
                    }
                  ]
                }
              ]
            },
            {
              "collectionName": "appeals",
              "createIndexes": [
                {
                  "name": "appeal_status",
                  "keys": [
                    {
                      "name": "status",
                      "direction": 1
                    }
                  ]
                },
                {
                  "name": "appeal_lesson_unique",
                  "keys": [
                    {
                      "name": "lessonId",
                      "direction": 1
                    }
                  ],
                  "unique": true
                },
                {
                  "name": "appeal_member",
                  "keys": [
                    {
                      "name": "memberId",
                      "direction": 1
                    }
                  ]
                }
              ]
            },
            {
              "collectionName": "ledger",
              "createIndexes": [
                {
                  "name": "ledger_package",
                  "keys": [
                    {
                      "name": "packageId",
                      "direction": 1
                    }
                  ]
                }
              ]
            },
            {
              "collectionName": "admins",
              "createIndexes": [
                {
                  "name": "admin_username_unique",
                  "keys": [
                    {
                      "name": "username",
                      "direction": 1
                    }
                  ],
                  "unique": true
                }
              ]
            },
            {
              "collectionName": "adminSessions",
              "createIndexes": [
                {
                  "name": "admin_session_token_unique",
                  "keys": [
                    {
                      "name": "token",
                      "direction": 1
                    }
                  ],
                  "unique": true
                }
              ]
            }
          ]
        }
      },
      "functions": {
        "use": "@cloudbase/framework-plugin-function",
        "inputs": {
          "functionRootPath": "cloudfunctions",
          "functions": [
            {
              "name": "gym-api",
              "path": "/gym-admin-api",
              "installDependency": true,
              "config": {
                "handler": "dist/index.main",
                "timeout": 10,
                "runtime": "Nodejs18.15",
                "memorySize": 256,
                "envVariables": {
                  "NODE_ENV": "production",
                  "GYM_PRODUCTION": "{{env.GYM_PRODUCTION}}",
                  "DEVELOPMENT_PAYMENTS_ENABLED": "{{env.DEVELOPMENT_PAYMENTS_ENABLED}}",
                  "WECHAT_PAYMENT_CREATE_URL": "{{env.WECHAT_PAYMENT_CREATE_URL}}",
                  "WECHAT_PAYMENT_API_TOKEN": "{{env.WECHAT_PAYMENT_API_TOKEN}}",
                  "INTERNAL_SCHEDULER_TOKEN": "{{env.INTERNAL_SCHEDULER_TOKEN}}"
                }
              }
            },
            {
              "name": "auto-complete-lessons",
              "installDependency": true,
              "config": {
                "handler": "dist/index.main",
                "timeout": 60,
                "runtime": "Nodejs18.15",
                "memorySize": 256,
                "envVariables": {
                  "NODE_ENV": "production",
                  "DEVELOPMENT_PAYMENTS_ENABLED": "false",
                  "INTERNAL_SCHEDULER_TOKEN": "{{env.INTERNAL_SCHEDULER_TOKEN}}"
                }
              },
              "triggers": [
                {
                  "name": "complete-overdue-lessons-hourly",
                  "type": "timer",
                  "config": "0 0 * * * * *"
                }
              ]
            },
            {
              "name": "wechat-payment-notify",
              "installDependency": true,
              "config": {
                "handler": "dist/index.main",
                "timeout": 10,
                "runtime": "Nodejs18.15",
                "memorySize": 256,
                "envVariables": {
                  "NODE_ENV": "production",
                  "WECHAT_PAYMENT_VERIFY_URL": "{{env.WECHAT_PAYMENT_VERIFY_URL}}",
                  "WECHAT_PAYMENT_API_TOKEN": "{{env.WECHAT_PAYMENT_API_TOKEN}}"
                }
              }
            }
          ]
        }
      }
    }
  }
}
