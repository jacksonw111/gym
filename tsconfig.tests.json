{
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "vitest"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "server/**/*.ts", "emas/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
