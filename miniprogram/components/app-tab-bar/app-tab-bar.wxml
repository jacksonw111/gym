<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-bar__item {{current === item.key ? 'tab-bar__item--active' : ''}}"
    data-url="{{item.url}}"
    bindtap="navigate"
    aria-role="button"
    aria-label="{{item.label}}"
  >
    <van-icon
      class="tab-bar__icon"
      name="{{item.icon}}"
      size="42rpx"
      aria-hidden="true"
     />
    <text class="tab-bar__label">{{item.label}}</text>
  </view>
</view>
