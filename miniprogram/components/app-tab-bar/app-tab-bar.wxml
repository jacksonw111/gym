<view wx:if="{{switching}}" class="tab-bar__mask">
  <view class="bean-eater" aria-hidden="true">
    <view class="bean-eater__stage">
      <view class="bean-eater__pellets">
        <view class="bean-eater__pellet" />
        <view class="bean-eater__pellet" />
        <view class="bean-eater__pellet" />
      </view>
      <view class="bean-eater__mouths">
        <view class="bean-eater__mouth" />
        <view class="bean-eater__mouth" />
        <view class="bean-eater__mouth" />
      </view>
    </view>
  </view>
  <text class="tab-bar__mask-kicker">PURUI / MOVE</text>
  <text class="tab-bar__mask-text">正在前往{{switchingLabel}}</text>
</view>
<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-bar__item {{current === item.key ? 'tab-bar__item--active' : ''}}"
    data-url="{{item.url}}"
    data-label="{{item.label}}"
    bindtap="navigate"
    hover-class="tab-bar__item--pressed"
    hover-stay-time="80"
    aria-role="button"
    aria-label="{{item.label}}"
  >
    <van-icon
      class="tab-bar__icon"
      name="{{item.icon}}"
      size="42rpx"
      aria-hidden="true"
     />
    <text class="tab-bar__label">{{item.label}}</text>
  </view>
</view>
