{
  "plugins": ["prettier-plugin-mp"],
  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "overrides": [
    {
      "files": "*.wxml",
      "options": {
        "parser": "wxml"
      }
    },
    {
      "files": "*.less",
      "options": {
        "parser": "less"
      }
    }
  ]
}
