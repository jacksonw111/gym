{
  "name": "purui-gym",
  "version": "1.0.0",
  "private": true,
  "description": "普瑞健身会员预约、教练排班与运营管理系统",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:lint": "biome check admin",
    "admin:test": "vitest run admin/src",
    "admin:typecheck": "tsc --noEmit -p admin/tsconfig.json",
    "cloud:test": "vitest run cloudfunctions",
    "cloud:build": "npm run build --prefix cloudfunctions/gym-api && npm run build --prefix cloudfunctions/auto-complete-lessons && npm run build --prefix cloudfunctions/wechat-payment-notify",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "format": "biome format --write . && prettier --write \"miniprogram/**/*.{wxml,less}\"",
    "lint": "biome lint . && stylelint \"miniprogram/**/*.less\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "check": "biome check . && prettier --check \"miniprogram/**/*.{wxml,less}\" && stylelint \"miniprogram/**/*.less\" && npm run typecheck && npm run admin:typecheck",
    "verify": "npm run check && npm run test && npm run cloud:build && npm run admin:build"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.6.7",
    "@vant/weapp": "1.11.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/generator": "7.28.3",
    "@babel/parser": "7.28.3",
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "happy-dom": "20.11.1",
    "miniprogram-api-typings": "5.2.2",
    "prettier": "3.9.6",
    "prettier-plugin-mp": "2.5.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-less": "4.1.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
